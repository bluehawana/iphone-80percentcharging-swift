# Tuya Cloud credentials — Mac-side diagnostics only.
#
# IMPORTANT: this is NOT read by the iOS app. Swift has no dotenv mechanism, and
# bundling secrets into the app would ship them inside the .ipa where anyone can
# read them. The app takes these values from its own settings form at runtime and
# stores them in the iOS Keychain (see Core/SettingsStore.swift).
#
# This file exists so `scripts/tuya.py` can verify your credentials from the Mac
# before you type them into the phone.
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# Data center matching the country your Deltaco / Smart Life account is registered in.
# One of: eu | us | cn | in     (Nordic/EU accounts → eu)
TUYA_REGION=eu

# Tuya IoT project → Authorization tab
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# Tuya IoT project → Devices → All Devices (after "Link App Account" QR scan)
TUYA_DEVICE_ID=

# The plug's on/off datapoint. Usually switch_1, sometimes switch.
# Run `python3 scripts/tuya.py detect` to find it.
TUYA_SWITCH_CODE=switch_1

# Your Apple Developer team ID — needed to sign the app for a real iPhone.
# Xcode → Settings → Accounts → your team, or developer.apple.com → Membership.
DEVELOPMENT_TEAM=
